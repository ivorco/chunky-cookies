{
  "name": "chunky-cookies",
  "version": "0.1.0",
  "description": "Cookie storage that transparently chunks large values across multiple cookies to bypass the 4KB browser limit",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./zustand": {
      "types": "./dist/adapters/zustand.d.ts",
      "import": "./dist/adapters/zustand.js"
    },
    "./next": {
      "types": "./dist/wrappers/next.d.ts",
      "import": "./dist/wrappers/next.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cookie",
    "cookies",
    "storage",
    "chunked",
    "zustand",
    "next",
    "nextjs",
    "persist",
    "4kb"
  ],
  "license": "MIT",
  "peerDependencies": {
    "js-cookie": ">=3.0.0",
    "next": ">=13.0.0",
    "zustand": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "js-cookie": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "zustand": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.6",
    "@vitest/coverage-v8": "^2.0.0",
    "js-cookie": "^3.0.5",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0",
    "zustand": "^5.0.0"
  }
}
